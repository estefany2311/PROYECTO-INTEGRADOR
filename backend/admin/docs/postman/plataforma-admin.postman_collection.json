        {
          "name": "10 Asignar docentes",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({ url: pm.collectionVariables.get(\"base_url\") + \"/docentes/\", header: [{ key: \"Authorization\", value: \"Bearer \" + pm.collectionVariables.get(\"token\") }] }, (err, res) => {",
                  "  const docentes = res.json();",
                  "  const libre = docentes.find(d => d.username === pm.collectionVariables.get(\"docente_user\") && !d.colegio)",
                  "    || docentes.find(d => !d.colegio);",
                  "  pm.collectionVariables.set(\"docente_id\", libre ? libre.id : 0);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total_docentes se actualiza\", () => pm.expect(pm.response.json().total_docentes).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/colegios/{{colegio_id}}/docentes/",
