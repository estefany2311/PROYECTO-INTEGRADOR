                  "  header: [{ key: \"Authorization\", value: \"Bearer \" + pm.collectionVariables.get(\"token\") }, { key: \"Content-Type\", value: \"application/json\" }],",
                  "  body: { mode: \"raw\", raw: JSON.stringify({ codigo_modular: String(Date.now() + 1).slice(-7), nombre: \"IE N° 54210 Huaccana\", region: \"Apurímac\" }) },",
                  "}, (err, res) => pm.collectionVariables.set(\"colegio2_id\", res.json().id));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Indica que ya pertenece a otro colegio\", () => pm.expect(pm.response.json().docentes.join(\" \")).to.include(\"ya pertenece al colegio\"));"
                ]
              }
            }
