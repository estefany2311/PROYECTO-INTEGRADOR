                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"El cóndor y el zorro (Postman)\",\n  \"texto\": \"Había una vez un cóndor que vivía en lo alto de la montaña.\",\n  \"tipo_reto\": \"lectura\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('lectura_id', pm.response.json().id);\npm.test('Guarda quién la creó', () => pm.expect(pm.response.json().creado_por).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por título",
