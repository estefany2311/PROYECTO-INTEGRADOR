            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Solo devuelve lecturas', () => pm.response.json().forEach(l => pm.expect(l.tipo_reto).to.eql('lectura')));"
                ]
              }
            }
          ]
        },
