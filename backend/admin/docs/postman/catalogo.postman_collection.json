            }
          ]
        },
        {
          "name": "Crear lectura válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/lecturas/",
