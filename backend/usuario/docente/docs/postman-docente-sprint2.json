    {
      "name": "US-24 · Alumnos",
      "description": "Alumnos: aula ajena (403), duplicado (409) y grado inválido (400).",
      "item": [
        {
          "name": "Aula ajena - 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// T-227: el aula existe pero es de otro docente",
                  "pm.test('aula de otro docente devuelve 403', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().mensaje).to.eql('El aula no pertenece al docente');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Docente-Id",
                "value": "{{otroDocenteId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"Quispe\",\n  \"gradoId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
